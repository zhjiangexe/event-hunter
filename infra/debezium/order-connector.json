{
  "name": "event-hunter-demo-order-outbox-v1",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "demo-order-postgres",
    "database.port": "5432",
    "database.user": "${DEMO_ORDER_POSTGRES_USER}",
    "database.password": "${DEMO_ORDER_POSTGRES_PASSWORD}",
    "database.dbname": "demo_order",
    "topic.prefix": "demo-order",
    "plugin.name": "pgoutput",
    "slot.name": "event_hunter_demo_order_outbox_v1",
    "publication.name": "event_hunter_demo_order_outbox_v1",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "public.outbox_events",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "correlation_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.table.json.payload.null.behavior": "optional_bytes",
    "transforms.outbox.route.by.field": "topic_name",
    "transforms.outbox.route.topic.regex": "(?<routedByValue>.*)",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType,service_version:header:x-service-version,trace_parent:header:traceparent,trace_state:header:tracestate"
  }
}
