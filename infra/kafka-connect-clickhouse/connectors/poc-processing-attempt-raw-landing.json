{
  "name": "event-hunter-poc-processing-attempt-raw-landing",
  "config": {
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "tasks.max": "1",
    "topics": "event-hunter.processing-attempts",
    "topic2TableMap": "event-hunter.processing-attempts=poc_processing_attempt_landing_raw",
    "hostname": "clickhouse",
    "port": "8123",
    "ssl": "false",
    "database": "event_hunter_poc",
    "username": "${CLICKHOUSE_USER}",
    "password": "${CLICKHOUSE_PASSWORD}",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter",
    "transforms": "hoistRaw,insertTransportMetadata",
    "transforms.hoistRaw.type": "org.apache.kafka.connect.transforms.HoistField$Value",
    "transforms.hoistRaw.field": "raw_payload",
    "transforms.insertTransportMetadata.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.insertTransportMetadata.topic.field": "source_topic",
    "transforms.insertTransportMetadata.partition.field": "source_partition",
    "transforms.insertTransportMetadata.offset.field": "source_offset",
    "exactlyOnce": "false",
    "reportInsertedOffsets": "true",
    "bufferCount": "0",
    "errors.retry.timeout": "60000",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "event-hunter.poc-clickhouse-sink.dlq",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false",
    "consumer.override.auto.offset.reset": "earliest"
  }
}
