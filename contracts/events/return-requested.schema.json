{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hunter.local/schemas/return-requested.schema.json",
  "title": "ReturnRequested",
  "allOf": [
    { "$ref": "./canonical-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ReturnRequested" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Return" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["returnId", "orderId", "shipmentId", "reason", "status"],
          "properties": {
            "returnId": { "type": "string", "minLength": 1 },
            "orderId": { "type": "string", "minLength": 1 },
            "shipmentId": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
            "status": { "const": "REQUESTED" }
          }
        }
      }
    }
  ]
}
