{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hunter.local/schemas/shipment-dispatched.schema.json",
  "title": "ShipmentDispatched",
  "allOf": [
    { "$ref": "./canonical-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ShipmentDispatched" },
        "eventVersion": { "const": 1 },
        "aggregateType": { "const": "Shipment" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shipmentId", "orderId", "provider", "trackingNumber", "status"],
          "properties": {
            "shipmentId": { "type": "string", "minLength": 1 },
            "orderId": { "type": "string", "minLength": 1 },
            "provider": { "type": "string", "minLength": 1 },
            "trackingNumber": { "type": "string", "minLength": 1 },
            "status": { "const": "DISPATCHED" }
          }
        }
      }
    }
  ]
}
