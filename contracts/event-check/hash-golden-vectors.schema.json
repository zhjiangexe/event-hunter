{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hunter.local/schemas/hash-golden-vectors.schema.json",
  "title": "Event Check Hash Golden Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "algorithm", "canonicalization", "vectors"],
  "properties": {
    "contract_version": { "const": 1 },
    "algorithm": { "const": "SHA-256" },
    "canonicalization": { "const": "RFC8785_JCS" },
    "vectors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "document", "canonical_utf8", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "kind": { "enum": ["EVENT_SET", "EVALUATION"] },
          "document": { "type": "object" },
          "canonical_utf8": { "type": "string", "minLength": 2 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
