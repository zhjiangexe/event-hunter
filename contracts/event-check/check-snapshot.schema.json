{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-hunter.local/schemas/check-snapshot.schema.json",
  "title": "Event Hunter Check Snapshot",
  "$ref": "#/$defs/CheckSnapshot",
  "$defs": {
    "CreateCheckSnapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_request", "expected_event_set_hash", "expected_evaluation_hash"],
      "properties": {
        "evaluation_request": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/EvaluationRequest"
        },
        "expected_event_set_hash": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/Sha256"
        },
        "expected_evaluation_hash": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/Sha256"
        },
        "retention_profile": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
                "version": { "type": "integer", "minimum": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "SnapshotEventReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "occurred_at", "producer", "aggregate_type", "aggregate_id", "correlation_id", "trace_id", "payload_sha256", "ordinal", "disposition", "adjustment_reason", "source_available"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "event_type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "producer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "aggregate_type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "aggregate_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "trace_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
        "payload_sha256": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/Sha256"
        },
        "ordinal": { "type": "integer", "minimum": 0 },
        "disposition": { "enum": ["INCLUDED", "EXCLUDED"] },
        "adjustment_reason": { "type": ["string", "null"], "maxLength": 500 },
        "source_available": { "type": "boolean" }
      }
    },
    "FindingFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "actor_id", "actor_role", "updated_at", "lock_version"],
      "properties": {
        "finding_id": { "type": "string", "format": "uuid" },
        "status": { "enum": ["UNREVIEWED", "CONFIRMED", "FALSE_POSITIVE", "NEEDS_REVIEW"] },
        "actor_id": { "type": "string", "maxLength": 200 },
        "actor_role": { "type": "string", "maxLength": 30 },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "lock_version": { "type": "integer", "minimum": 0 }
      }
    },
    "CheckSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provenance", "created_by", "created_by_role", "created_at", "evaluation_request", "as_of", "source_health", "model", "result", "event_references", "relationships", "finding_feedback", "event_set_hash", "evaluation_hash", "result_schema_version", "retention_profile"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "provenance": { "enum": ["LIVE_EVALUATION", "LEGACY_PATTERN_MIGRATION"] },
        "created_by": { "type": "string", "minLength": 1, "maxLength": 200 },
        "created_by_role": { "enum": ["INVESTIGATOR", "ADMIN"] },
        "created_at": { "type": "string", "format": "date-time" },
        "evaluation_request": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/EvaluationRequest"
        },
        "as_of": { "type": "string", "format": "date-time" },
        "source_health": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/SourceHealth"
        },
        "model": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/ModelRef"
        },
        "result": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/CheckResult"
        },
        "event_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/SnapshotEventReference" }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "./event-check-evaluation.schema.json#/$defs/Relationship"
          }
        },
        "finding_feedback": {
          "description": "Current mutable feedback projection. It is not part of the immutable Snapshot or evaluation_hash.",
          "type": "array",
          "items": { "$ref": "#/$defs/FindingFeedback" }
        },
        "event_set_hash": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/Sha256"
        },
        "evaluation_hash": {
          "$ref": "./event-check-evaluation.schema.json#/$defs/Sha256"
        },
        "result_schema_version": { "const": 1 },
        "retention_profile": { "type": ["object", "null"] }
      }
    }
  }
}
