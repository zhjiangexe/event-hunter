# 僅供本機開發。正式環境不得沿用這些密碼，應改由 Secret Manager／Vault 注入。
DEMO_SESSION_SECRET=demo_session_local_only
GRAFANA_WEBHOOK_SECRET=grafana_webhook_local_only

POSTGRES_DB=event_hunter
POSTGRES_USER=event_hunter
POSTGRES_PASSWORD=event_hunter_local_only
POSTGRES_PORT=28313

# 三個示範服務各自擁有資料庫；加入 Compose 時不得共用 schema 或跨服務查表。
DEMO_ORDER_POSTGRES_USER=demo_order
DEMO_ORDER_POSTGRES_PASSWORD=demo_order_local_only
DEMO_ORDER_POSTGRES_PORT=28314
DEMO_PAYMENT_POSTGRES_USER=demo_payment
DEMO_PAYMENT_POSTGRES_PASSWORD=demo_payment_local_only
DEMO_PAYMENT_POSTGRES_PORT=28315
DEMO_SHIPPING_POSTGRES_USER=demo_shipping
DEMO_SHIPPING_POSTGRES_PASSWORD=demo_shipping_local_only
DEMO_SHIPPING_POSTGRES_PORT=28316
# 每一筆 live demo Domain Event 建立前的情境延遲；設為 0s 可供快速測試。
DEMO_EVENT_EMISSION_DELAY=2s

CLICKHOUSE_DB=event_hunter
CLICKHOUSE_USER=event_hunter
CLICKHOUSE_PASSWORD=event_hunter_local_only
CLICKHOUSE_HTTP_PORT=28317
CLICKHOUSE_NATIVE_PORT=28318

KAFKA_PORT=28319
SCHEMA_REGISTRY_PORT=28320
REDPANDA_HTTP_PROXY_PORT=28321
REDPANDA_ADMIN_PORT=28322
REDPANDA_CONSOLE_PORT=28323
KAFKA_CONNECT_REST_PORT=28324

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_local_only
PROMETHEUS_PORT=28326
LOKI_PORT=28327
TEMPO_PORT=28328
OTEL_GRPC_PORT=28329
OTEL_HTTP_PORT=28330
OTEL_HEALTH_PORT=28331
GRAFANA_PORT=28332

# 應用服務與獨立 processing-attempt ingestion pipeline。
EVENT_HUNTER_API_PORT=28333
EVENT_HUNTER_FRONTEND_PORT=28334
EVENT_HUNTER_HTTP_REQUEST_TIMEOUT=5s
EVENT_HUNTER_POSTGRES_QUERY_TIMEOUT=2s
EVENT_HUNTER_CLICKHOUSE_QUERY_TIMEOUT=3s
EVENT_HUNTER_RATE_LIMIT_WINDOW=1m
EVENT_HUNTER_RATE_LIMIT_REQUESTS=300
EVENT_HUNTER_ATTEMPTS_INGESTION_MODE=clickhouse-mv
EVENT_HUNTER_CLICKHOUSE_MAX_RESULT_ROWS=10000
EVENT_HUNTER_CLICKHOUSE_MAX_RESULT_BYTES=8388608
EVENT_HUNTER_CLICKHOUSE_MAX_ROWS_TO_READ=5000000
EVENT_HUNTER_CLICKHOUSE_MAX_BYTES_TO_READ=536870912
EVENT_HUNTER_CLICKHOUSE_MAX_THREADS=4
# Leave blank for the Compose frontend same-origin /api proxy; use the API URL only with `pnpm dev`.
VITE_API_BASE_URL=
VITE_GRAFANA_URL=http://localhost:28332
DEMO_ORDER_API_PORT=28335
DEMO_PAYMENT_SERVICE_PORT=28336
DEMO_SHIPPING_SERVICE_PORT=28337
CLICKHOUSE_POC_CONNECT_REST_PORT=28345
TECHNICAL_DLQ_PROJECTOR_HEALTH_PORT=28346
# API readiness probes follow the formally adopted ClickHouse-first runtime.
EVENT_HUNTER_INGESTION_MODE=clickhouse-mv
QUALITY_WORKER_HEALTH_PORT=28338
UI_PROTOTYPE_PORT=28339
OPENAPI_PREVIEW_PORT=28340

# 只有使用 --profile temporal 時才會開啟。
TEMPORAL_GRPC_PORT=28341
TEMPORAL_UI_PORT=28342
EVENT_LAB_PORT=28343
