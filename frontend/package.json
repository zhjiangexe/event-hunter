{
  "name": "event-hunter-console",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:generate": "openapi-typescript ../openapi.yaml -o src/generated/openapi.ts",
    "api:check": "openapi-typescript ../openapi.yaml -o src/generated/openapi.ts --check",
    "scenario-api:generate": "openapi-typescript ../contracts/event-lab/event-lab.openapi.yaml -o src/generated/event-lab-openapi.ts",
    "scenario-api:check": "openapi-typescript ../contracts/event-lab/event-lab.openapi.yaml -o src/generated/event-lab-openapi.ts --check",
    "format": "prettier --write src vite.config.ts eslint.config.js",
    "format:check": "prettier --check src vite.config.ts eslint.config.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  }
}
