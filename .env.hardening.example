# Copy to an ignored file such as .env.hardening and replace every CHANGE_ME.
# This profile is a single-host internal staging/pilot baseline, not an HA or
# internet-facing production topology.
DEMO_SESSION_SECRET=CHANGE_ME_RANDOM_32_CHARS_OR_MORE
GRAFANA_WEBHOOK_SECRET=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
DEMO_ORDER_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
DEMO_PAYMENT_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
DEMO_SHIPPING_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
CLICKHOUSE_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS
GRAFANA_CLICKHOUSE_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_32_CHARS

EVENT_HUNTER_PUBLIC_URL=https://event-hunter.internal.example
GRAFANA_PUBLIC_URL=https://grafana.internal.example
VITE_GRAFANA_URL=https://grafana.internal.example
EVENT_HUNTER_TLS_PORT=28443
GRAFANA_TLS_PORT=28444

# Absolute host paths. Private keys must not be group/world-readable.
EVENT_HUNTER_TLS_CERT_PATH=/absolute/path/to/event-hunter.crt
EVENT_HUNTER_TLS_KEY_PATH=/absolute/path/to/event-hunter.key
GRAFANA_TLS_CERT_PATH=/absolute/path/to/grafana.crt
GRAFANA_TLS_KEY_PATH=/absolute/path/to/grafana.key
